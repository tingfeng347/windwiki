+// mermaid.render is not safe to call concurrently: overlapping calls share
+// global mermaid state and, with the same element id, can clobber each other
+// and return an empty diagram. Serialize every render through one promise
+// chain, and give each attempt a unique id.
+let renderQueue: Promise<unknown> = Promise.resolve();
+
+function enqueue<T>(task: () => Promise<T>): Promise<T> {
+  const run = renderQueue.then(task, task);
+  renderQueue = run.catch(() => undefined);
+  return run;
+}
